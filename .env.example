# ---------- Gmail ----------
# Path to OAuth desktop-client secrets downloaded from Google Cloud Console.
GOOGLE_CLIENT_SECRETS=secrets/client_secret.json
# Where the refresh token is cached after `python -m app.auth_setup`.
GMAIL_TOKEN_FILE=secrets/token.json
# For hosted runs (GitHub Actions / Render / HF Spaces) paste token.json contents here instead.
GMAIL_TOKEN_JSON=
# Gmail search query used on every poll. Keep it broad; classification happens later.
GMAIL_QUERY=in:inbox -category:promotions
# Look back this many days on the very first run.
GMAIL_INITIAL_LOOKBACK_DAYS=3
# Max messages handled per poll (keeps free-tier runtimes short).
GMAIL_MAX_RESULTS=60
# Apply a Gmail label to matched mail. Requires the gmail.modify scope.
GMAIL_APPLY_LABEL=false
GMAIL_LABEL_NAME=JobAgent

# ---------- Storage ----------
# SQLite by default. Free hosted Postgres works too:
#   postgresql+psycopg://user:pass@host:5432/db   (Supabase / Neon free tier)
DATABASE_URL=sqlite:///data/jobagent.db

# ---------- Matching ----------
PROFILE_PATH=config/profile.yaml
MIN_JOB_SCORE=0.45
MAX_JOBS_PER_EMAIL=25
SCRAPE_JOB_PAGES=true
SCRAPE_TIMEOUT=15

# ---------- LLM (all optional, free tiers) ----------
# Set LLM_PROVIDER to anything except `none` to turn models on. The app then walks
# every key you have, in this order:
#   classify (high volume): groq -> gemini -> nvidia -> deepseek -> openrouter
#   extract  (rare, long):  nvidia -> deepseek -> gemini -> groq -> openrouter
# A provider that rate-limits is skipped for LLM_COOLDOWN_SECONDS.
# Override the walk with LLM_CHAIN_CLASSIFY / LLM_CHAIN_EXTRACT, e.g.
#   gemini,gemini2,groq
# Two Google AI Studio accounts: put the original key in GEMINI_API_KEY and the
# new account in GEMINI_API_KEY_2. After each successful Gemini call that key
# rests LLM_GEMINI_GAP_SECONDS so the other account takes the next request.
LLM_PROVIDER=gemini
LLM_CHAIN=
LLM_CHAIN_CLASSIFY=
LLM_CHAIN_EXTRACT=
LLM_COOLDOWN_SECONDS=900
LLM_GEMINI_GAP_SECONDS=8
LLM_CLASSIFY_BODY_CHARS=4000
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---------- Notifications ----------
# Free: create a bot with @BotFather, get chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_ON_JOBS=true
NOTIFY_ON_OUTREACH=true

# ---------- Web ----------
# Shared secret required by POST /api/run and any write endpoint.
API_TOKEN=change-me
PORT=8000
